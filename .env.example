# ===== Stripe（美国账号）=====
# 在 https://dashboard.stripe.com/apikeys 获取
# Test 模式用 sk_test_ / pk_test_；上线切 Live 时换成 sk_live_ / pk_live_
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ===== 站点 =====
# 品牌名（可选，留空则用默认 Paw & Thread）
NEXT_PUBLIC_SITE_NAME=Paw & Thread
# 是否使用本地 Mock 数据（true=用内置示例数据，false=接真实后端）
NEXT_PUBLIC_USE_MOCK=true
# 你的正式域名（用于 Stripe 成功/取消跳转，部署后改成真实域名）
NEXT_PUBLIC_SITE_URL=https://your-domain.com
